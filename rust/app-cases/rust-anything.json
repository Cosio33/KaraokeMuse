{
  "schema": "rust-anything/app-cases@1",
  "name": "record-server",
  "run": [
    "sh",
    "rust/record-server.sh"
  ],
  "normalize": [
    "timestamps",
    "uuids"
  ],
  "normalizers": {
    "newid": "(song|q|req|u|room)_[0-9a-f]{16}",
    "token": "[0-9a-f]{64}"
  },
  "timeout_secs": 30,
  "http": {}
}
